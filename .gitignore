Cargo.lock

test_data/*.json

# These are backup files generated by rustfmt
**/*.rs.bk

**/node_modules

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

.env
# Prediction dumps from `revalidate --dump-predictions` and the curves fitted off them.
# Regenerable from a checkpoint, and large enough not to belong in git.
data/*_predictions.csv
data/*_curve.csv
